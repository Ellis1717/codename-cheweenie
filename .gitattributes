# Preserve Unity's generated empty scalar formatting in retained art resources.
Assets/Art/** whitespace=-trailing-space,-blank-at-eof
Assets/Art.meta whitespace=-trailing-space
Assets/Art/Marty.meta whitespace=-trailing-space
Assets/Resources/MartyVisual.prefab whitespace=-trailing-space
Assets/Resources/MartyVisual.prefab.meta whitespace=-trailing-space
Assets/Resources/Cats/** whitespace=-trailing-space
Assets/Resources/Cats.meta whitespace=-trailing-space
Assets/Resources/SceneryPalette.asset whitespace=-trailing-space
Assets/Resources/SceneryPalette.asset.meta whitespace=-trailing-space
Assets/Resources/Motion/** whitespace=-trailing-space
Assets/Resources/Motion.meta whitespace=-trailing-space
Assets/Resources/VisualLab/** whitespace=-trailing-space

# The source fingerprint must survive Windows Git line-ending conversion.
Assets/Art/Marty/Source/Marty_Explorer.obj -text
Assets/Art/Marty/Source/Marty_Explorer.glb binary
docs/screenshots/*.gif binary
Unreal/**/*.uasset binary
Unreal/**/*.umap binary
Unreal/VisualLab/SourceAssets/*.obj binary
