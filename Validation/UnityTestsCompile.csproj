<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UnityEditorPath Condition="'$(UnityEditorPath)' == ''">C:\Program Files\Unity\Hub\Editor\6000.3.10f1\Editor</UnityEditorPath>
    <InputSystemAssembly Condition="'$(InputSystemAssembly)' == ''">../Library/ScriptAssemblies/Unity.InputSystem.dll</InputSystemAssembly>
    <InputSystemAssembly Condition="!Exists('$(InputSystemAssembly)')">UnityAudioProject/Library/ScriptAssemblies/Unity.InputSystem.dll</InputSystemAssembly>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Assets/Scripts/**/*.cs" /><Compile Include="../Assets/Tests/**/*.cs" /><Compile Include="../Assets/Editor/**/*.cs" />
    <Reference Include="$(UnityEditorPath)/Data/Managed/UnityEngine/*.dll" />
    <Reference Include="Unity.InputSystem"><HintPath>$(InputSystemAssembly)</HintPath></Reference>
    <Reference Include="$(UnityEditorPath)/Data/Managed/UnityEditor/*.dll" />
    <Reference Include="$(UnityEditorPath)/Data/Resources/PackageManager/BuiltInPackages/com.unity.ext.nunit/net40/unity-custom/nunit.framework.dll" />
    <Reference Include="$(UnityEditorPath)/Data/Resources/PackageManager/ProjectTemplates/libcache/com.unity.template.3d-cross-platform-17.0.14/ScriptAssemblies/UnityEngine.TestRunner.dll" />
  </ItemGroup>
</Project>
